# 本機開發資料庫（libsql 讀本機 SQLite 檔，相對於專案根目錄）
DATABASE_URL="file:./local.db"

# 應用程式 URL（用於 QRCode 產生，以及 SEO 的 metadataBase / canonical / sitemap / robots）
# NEXT_PUBLIC_ 變數在 build 期就會被內聯，正式部署務必於 build 環境設成正式網域：
#   NEXT_PUBLIC_APP_URL="https://little-teacher-helper.app"
# 未設定時 src/lib/site.ts 會退回正式網域；但若用帶有本機值的 .env.local 打正式包，會被內聯成 localhost。
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 開發模式
NODE_ENV="development"
